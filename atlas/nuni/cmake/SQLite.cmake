include(FetchContent)
option(NUNI_BUNDLED_SQLITE "Build pinned SQLite for both native and atlas targets" ON)
if(NUNI_BUNDLED_SQLITE)
  FetchContent_Declare(nuni_sqlite_source
    URL https://www.sqlite.org/2026/sqlite-amalgamation-3540100.zip
    URL_HASH SHA3_256=92281c86e2957f9b9305890f9ac04204caa7b677cc868dc326d942689df28e30)
  FetchContent_GetProperties(nuni_sqlite_source)
  if(NOT nuni_sqlite_source_POPULATED)
    FetchContent_Populate(nuni_sqlite_source)
  endif()
  add_library(nuni_sqlite STATIC ${nuni_sqlite_source_SOURCE_DIR}/sqlite3.c)
  target_include_directories(nuni_sqlite PUBLIC ${nuni_sqlite_source_SOURCE_DIR})
  target_compile_definitions(nuni_sqlite PRIVATE SQLITE_THREADSAFE=1 SQLITE_OMIT_LOAD_EXTENSION)
  target_link_libraries(nuni_sqlite PUBLIC Threads::Threads ${CMAKE_DL_LIBS} m)
else()
  find_package(SQLite3 REQUIRED)
  add_library(nuni_sqlite INTERFACE)
  target_link_libraries(nuni_sqlite INTERFACE SQLite::SQLite3)
endif()
